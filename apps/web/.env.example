# ローカル開発用の環境変数。このファイルを .env.local にコピーして値を入れる。
# （.env.local は gitignore 対象。コミットしない）

# web が叩く api のベースURL。ローカル api（`pnpm --filter api dev` = wrangler dev :8787）を指す。
#   - API_URL          … サーバ側（Server Action / Route Handler）が使う
#   - NEXT_PUBLIC_API_URL … クライアント側（公開ビューア等）がビルド時に焼く
API_URL=http://localhost:8787
NEXT_PUBLIC_API_URL=http://localhost:8787

# Google OAuth クライアントID（ローカル用に作成し、JS生成元に http://localhost:3000 を登録したもの）。
# 重要: ローカル api の GOOGLE_CLIENT_ID と「同じ値」にすること
#       （web が発行するトークンの aud を api がこのIDで検証するため。不一致だと /api/session が 401）。
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
