{
  "expo": {
    "name": "RAISHA",
    "slug": "rigel",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["ios", "android"],
    "scheme": "jp.co.plaria.rigel",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "jp.co.plaria.rigel",
      "usesAppleSignIn": true,
      "supportsTablet": false,
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.561655423126-3i5s5c5am9u4g6pijpofomiacttrv5kh"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "jp.co.plaria.rigel",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#13a274"
      },
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-apple-authentication",
      "@react-native-firebase/app",
      "@react-native-firebase/analytics",
      "@react-native-firebase/crashlytics",
      [
        "expo-image-picker",
        {
          "photosPermission": "卓の写真から牌譜を作成するために、写真ライブラリへのアクセスを許可してください。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#0f1115"
        }
      ]
    ]
  }
}
