{
  "expo": {
    "name": "Rigel",
    "slug": "rigel",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["ios", "android"],
    "scheme": "jp.co.plaria.rigel",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "jp.co.plaria.rigel",
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.561655423126-3i5s5c5am9u4g6pijpofomiacttrv5kh"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "jp.co.plaria.rigel",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#13a274"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-secure-store", "expo-apple-authentication", "./plugins/with-openiap-pin"]
  }
}
