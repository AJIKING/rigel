# dependencies
node_modules/

# build output
dist/
out/
.next/
.turbo/
*.tsbuildinfo
# Next.js が生成（build/dev で再生成される）
next-env.d.ts

# cloudflare / wrangler
.wrangler/
.dev.vars
# opennextjs/cloudflare build output (web)
.open-next/

# expo / react native
.expo/

# test
coverage/
# playwright（実ブラウザ検証の生成物）
test-results/
playwright-report/
.playwright/

# local overrides (machine-managed, do not commit)
.claude/settings.local.json

# env / secrets
.env
.env.*
!.env.example

# eval（実 Gemini の生成物。人手確認済みの truth.json だけを管理する）
apps/api/eval-fixtures/cases/*/truth.draft.json
apps/api/eval-fixtures/last-report.txt

# misc
.DS_Store
*.log
# ツール実行の残骸（リポジトリ直下に生成されることがある）
channels-log.txt

# 作業用スクショ（オーナーが会話添付に使う一時ファイル）
docs/image*.png

# IDE 生成物（JetBrains）。
.idea/
